{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI WorkStudio",
  "mainBinaryName": "workstudio",
  "version": "0.1.1",
  "identifier": "app.workstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI WorkStudio",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb", "rpm", "nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "One workspace for your local AI apps",
    "longDescription": "AI WorkStudio brings brain, OpenCue, Lumina and future apps into one workspace: status, notifications, updates, shared MCP servers and up to six terminals at once.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": { "nsis": { "installMode": "currentUser" } },
    "macOS": { "minimumSystemVersion": "11.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFQUNFQjI0RUYzN0JGREIKUldUYnZ6ZnZKT3VzVGpmS1FJa1ZjWitKNnVZTWszMW5CS0NtZkIwVEFjQ2I3T3duOWtoYlZObTEK",
      "endpoints": ["https://github.com/Lautaro005/workstudio/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
